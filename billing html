<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bright Home - Billing HD</title>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial}
body{background:#0a0a0a;color:#fff;padding:10px}
.header{background:linear-gradient(135deg,#8B0000,#000);border:2px solid #ff0000;padding:18px;text-align:center;border-radius:14px}
.header h1{font-size:18px}.header p{color:#ffcc00;font-size:11px;margin-top:4px}
#billToCapture{background:#fff;color:#000;padding:15px;border-radius:10px;margin-top:10px;border:2px solid #8B0000}
.bh-top{text-align:center;border-bottom:3px solid #8B0000;padding-bottom:10px;margin-bottom:10px}
.bh-top h2{color:#8B0000;font-size:18px}
.row{display:flex;gap:8px;margin-bottom:8px;flex-wrap:wrap}
.row input,.row select{flex:1;min-width:100px;padding:8px;border:1px solid #ccc;border-radius:6px;background:#fff;color:#000}
table{width:100%;border-collapse:collapse;margin-top:10px}
th{background:#8B0000;color:#fff;padding:7px 3px;font-size:10px}
td{border:1px solid #ccc;padding:2px;font-size:10px;background:#fff;color:#000}
td input,td select{width:100%;border:none!important;padding:6px}
.btn-add{background:#28a745;color:#fff;padding:8px 12px;border:none;border-radius:6px;margin-top:6px}
.btn-hd{background:#ffcc00;color:#000;width:100%;padding:14px;margin-top:12px;border:none;border-radius:8px;font-weight:bold;font-size:14px}
.btn-save{background:#007bff;color:#fff;width:100%;padding:14px;margin-top:8px;border:none;border-radius:8px;font-weight:bold}
.vertical-btns{display:flex;flex-direction:column;gap:6px}
.vertical-btns button{padding:6px;font-size:10px;border-radius:6px;border:none;font-weight:bold}
.v-save{background:#28a745;color:#fff}.v-print{background:#17a2b8;color:#fff}.v-del{background:#dc3545;color:#fff}
.bill-span{display:inline-block;padding:6px;background:#fff;color:#000;width:100%;font-size:12px}
.totals{background:#f5f5f5;color:#000;padding:10px;border-radius:8px;margin-top:10px}
.totals .r{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dashed #ccc}
</style>
</head>
<body>
<div class="header"><h1>🏠 BRIGHT HOME CONSTRUCTION MATERIALS</h1><p>Gojra - Toba Road | HD Billing - Full Bill Save</p></div>
<div id="billToCapture">
<div class="bh-top"><h2>Bright Home Builders</h2><p>Main Toba Road Gojra | 03001070298</p></div>
<div class="row"><input id="cName" placeholder="Customer Name"><input id="cMobile" placeholder="Mobile"></div>
<div class="row"><input id="cAddr" placeholder="Address"><input id="cGaari" placeholder="Gaari No"></div>
<table><thead><tr><th>#</th><th>Item</th><th>Qty</th><th>Rate</th><th>Amt</th><th>X</th></tr></thead><tbody id="itemsBody"></tbody></table>
<button class="btn-add" onclick="addRow()">+ Add Item</button>
<div class="totals">
<div class="r"><span>Items Total</span><span id="itemsTotal">0</span></div>
<div class="r"><span>Gaari Rent</span><input id="gaariRent" type="number" value="0" oninput="calc()" style="width:80px;border:1px solid #ccc!important;padding:4px"></div>
<div class="r"><span>Labor</span><input id="labor" type="number" value="0" oninput="calc()" style="width:80px;border:1px solid #ccc!important;padding:4px"></div>
<div class="r"><span>Discount</span><input id="discount" type="number" value="0" oninput="calc()" style="width:80px;border:1px solid #ccc!important;padding:4px"></div>
<div class="r" style="font-weight:bold;color:#8B0000"><span>Net Total</span><span id="netTotal">0</span></div>
<div class="r"><span>Paid</span><input id="paid" type="number" value="0" oninput="calc()" style="width:80px;border:1px solid #ccc!important;padding:4px"></div>
<div class="r" style="font-weight:bold;color:green"><span>Remaining</span><span id="remaining">0</span></div>
</div>
</div>
<button class="btn-hd" onclick="saveCustomerBillAsImage()">📸 Save HD Bill Image (Full - No Cut)</button>
<button class="btn-save" onclick="saveBill()">💾 Save to History</button>
<div style="background:#1e1e1e;padding:10px;margin-top:12px;border-radius:10px">
<table style="width:100%"><thead><tr><th style="color:#ffcc00;font-size:10px">Bill</th><th style="color:#ffcc00;font-size:10px">Customer</th><th style="color:#ffcc00;font-size:10px">Total</th><th style="color:#ffcc00;font-size:10px">Actions</th></tr></thead><tbody id="historyBody"></tbody></table>
</div>
